{
  "name": "study-hall",
  "productName": "Study Hall",
  "version": "2.6.0",
  "description": "Class notebooks that turn photos into notes, flashcards, practice tests and study guides.",
  "main": "main.js",
  "private": true,
  "author": "Study Hall",
  "scripts": {
    "start": "electron .",
    "smoke": "electron test/smoke-main.js",
    "dist": "electron-builder --win nsis",
    "dist:linux": "electron-builder --win dir --x64 -c.win.signAndEditExecutable=false && mv dist/win-unpacked \"dist/Study Hall\" && node build/stamp-exe.mjs \"dist/Study Hall/Study Hall.exe\" && cd build && makensis -V2 -DVERSION=$npm_package_version -DAPPDIR=\"../dist/Study Hall\" -DOUTFILE=\"../dist/StudyHall Installer.exe\" installer.nsi",
    "docs": "node build/make-docs.mjs",
    "build:web": "node build/build-web.mjs",
    "dist:mac": "electron-builder --mac --publish never",
    "android": "npm run build:web && npx cap sync android"
  },
  "dependencies": {
    "@capgo/capacitor-updater": "^8.54.2",
    "@supabase/supabase-js": "^2.119.2",
    "docx": "^9.16.0",
    "jszip": "^3.10.2",
    "katex": "^0.16.11",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "pptxgenjs": "4.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "pe-library": "^2.0.3",
    "resedit": "^3.1.1"
  },
  "build": {
    "appId": "com.studyhall.app",
    "productName": "Study Hall",
    "files": [
      "main.js",
      "preload.js",
      "quizlet-import.js",
      "files.js",
      "updater.js",
      "notes/**/*",
      "src/**/*",
      "node_modules/katex/dist/**/*",
      "node_modules/pdfjs-dist/legacy/build/pdf.min.mjs",
      "node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs",
      "node_modules/mammoth/mammoth.browser.min.js",
      "node_modules/jszip/dist/jszip.min.js",
      "node_modules/docx/dist/index.iife.js",
      "node_modules/pptxgenjs/dist/pptxgen.bundle.js",
      "node_modules/@supabase/supabase-js/dist/umd/supabase.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "StudyHall Installer.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "StudyHall-macOS.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Study Hall records lectures and voice notes, and lets you dictate notes, when you choose to."
      }
    },
    "linux": {
      "target": "AppImage",
      "category": "Education"
    },
    "dmg": {
      "title": "Study Hall"
    },
    "afterPack": "build/adhoc-sign.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iNemesisX/study-hall.git"
  },
  "homepage": "https://github.com/iNemesisX/study-hall",
  "nativeVersion": "2.6.0"
}
